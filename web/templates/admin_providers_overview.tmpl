{{define "content"}}
<div class="admin-section admin-console">
  {{template "admin_nav" .}}

  {{if .Notice}}<div class="notice success">{{.Notice}}</div>{{end}}
  {{if .Error}}<div class="notice error">{{.Error}}</div>{{end}}

  <div class="admin-header admin-page-header">
    <div>
      <h1>{{index $.Translations "admin.providers.title"}}</h1>
    </div>
  </div>

  <div class="card table-card admin-table-card">
    <table class="admin-table">
      <thead>
        <tr>
          <th scope="col">{{index $.Translations "admin.users.tenant"}}</th>
          <th scope="col">{{index $.Translations "admin.providers.provider_key"}}</th>
          <th scope="col">{{index $.Translations "admin.providers.type_label"}}</th>
          <th scope="col">{{index $.Translations "admin.providers.name_label"}}</th>
          <th scope="col">{{index $.Translations "common.status"}}</th>
          <th scope="col">{{index $.Translations "common.actions"}}</th>
        </tr>
      </thead>
      <tbody>
        {{if .AdminProviderRows}}
        {{range .AdminProviderRows}}
        <tr>
          <td><strong>{{.TenantName}}</strong></td>
          <td><code>{{.ProviderKey}}</code></td>
          <td><span class="status-badge">{{.Kind}}</span></td>
          <td>{{.DisplayName}}</td>
          <td>{{if .Enabled}}<span class="status-badge status-badge-success">{{index $.Translations "common.active"}}</span>{{else}}<span class="status-badge status-badge-muted">{{index $.Translations "common.inactive"}}</span>{{end}}</td>
          <td class="admin-actions-inline">
            <a href="/admin/tenants/{{.TenantID}}/providers" class="button button-secondary button-small">{{index $.Translations "admin.users.open_tenant"}}</a>
          </td>
        </tr>
        {{end}}
        {{else}}
        <tr>
          <td colspan="6" class="muted admin-empty-row">{{index $.Translations "admin.providers.no_providers"}}</td>
        </tr>
        {{end}}
      </tbody>
    </table>
  </div>
</div>
{{end}}
