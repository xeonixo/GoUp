{{define "content"}}
<section class="login-shell">
  <a class="login-brand" href="/" aria-label="{{index $.Translations "common.home"}}">
    <img class="login-brand-logo" src="/assets/logo_goup.svg" alt="GoUp Logo">
  </a>
  <article class="card login-card stack">
    <div>
      <h1>{{index $.Translations "admin.access.title"}}</h1>
    </div>

    {{if .Error}}<div class="notice error">{{.Error}}</div>{{end}}
    {{if .Notice}}<div class="notice success">{{.Notice}}</div>{{end}}

    {{if .AdminAccessTOTPStage}}
    <form id="admin-otp-form" name="otp" method="POST" action="/admin/access" class="stack login-form" autocomplete="on" aria-label="{{index $.Translations "admin.access.totp_label"}}">
      <label for="otp">{{index $.Translations "admin.access.totp_label"}}</label>
      <input id="otp" name="otp" type="text" inputmode="numeric" pattern="[0-9]{6}" minlength="6" maxlength="6" required autocomplete="one-time-code" autocapitalize="none" autocorrect="off" spellcheck="false" enterkeyhint="go" aria-label="{{index $.Translations "admin.access.totp_label"}}" autofocus>
      <button type="submit" class="button">{{index $.Translations "admin.access.login_button"}}</button>
    </form>
    {{else}}
    <form id="admin-login-form" name="login" method="POST" action="/admin/access" class="stack login-form" autocomplete="on" aria-label="{{index $.Translations "admin.access.title"}}">
      <label for="username">{{index $.Translations "field.username"}}</label>
      <input id="username" name="username" type="text" required autocomplete="username" autocapitalize="none" autocorrect="off" spellcheck="false" enterkeyhint="next">
      <label for="password">{{index $.Translations "field.password"}}</label>
      <input id="password" name="password" type="password" required autocomplete="current-password" autocapitalize="none" autocorrect="off" spellcheck="false" enterkeyhint="go">
      <button type="submit" class="button">{{index $.Translations "admin.access.login_button"}}</button>
    </form>
    {{end}}
  </article>
</section>
{{end}}
