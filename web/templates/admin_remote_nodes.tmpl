{{define "content"}}
<div class="admin-section admin-console" id="remote-nodes-page" data-live-base="/admin/tenants/{{.AdminTenant.ID}}/remote-nodes/live" data-expired-redirect="/admin/access" data-i18n-online="{{index $.Translations "admin.remote_nodes.online"}}" data-i18n-offline="{{index $.Translations "admin.remote_nodes.offline"}}" data-i18n-entries="{{index $.Translations "admin.remote_nodes.entries"}}" data-i18n-from="{{index $.Translations "admin.remote_nodes.from"}}">
  <nav class="admin-nav admin-console-nav card" aria-label="{{index $.Translations "layout.control_plane"}}">
    <a href="/admin/" class="admin-nav-link">{{index $.Translations "admin.nav.general"}}</a>
    <a href="/admin/tenants" class="admin-nav-link">{{index $.Translations "admin.nav.tenants"}}</a>
    <a href="/admin/tenants/{{.AdminTenant.ID}}/providers" class="admin-nav-link">{{index $.Translations "admin.nav.providers"}}</a>
    <a href="/admin/tenants/{{.AdminTenant.ID}}/local-users" class="admin-nav-link">{{index $.Translations "admin.nav.users"}}</a>
    <a href="/admin/tenants/{{.AdminTenant.ID}}/remote-nodes" class="admin-nav-link is-active">{{index $.Translations "admin.nav.remote_nodes"}}</a>
  </nav>

  {{if .Notice}}<div class="notice success">{{.Notice}}</div>{{end}}
  {{if .Error}}<div class="notice error">{{.Error}}</div>{{end}}
  {{if .RemoteNodeProvisioningVars}}
  <section class="remote-node-env-card card" aria-label="{{index $.Translations "admin.remote_nodes.provisioning_title"}}">
    <div class="remote-node-env-header">
      <h2>{{index $.Translations "admin.remote_nodes.provisioning_title"}}</h2>
    </div>
    <pre class="remote-node-env-code"><code>{{range .RemoteNodeProvisioningVars}}export {{.Key}}="{{.Value}}"
{{end}}</code></pre>
    <div class="remote-node-env-grid" aria-hidden="true">
      {{range .RemoteNodeProvisioningVars}}
      <div class="remote-node-env-row">
        <span>{{.Key}}</span>
        <code>{{.Value}}</code>
      </div>
      {{end}}
    </div>
  </section>
  {{end}}

  <div class="admin-header admin-page-header">
    <div>
      <h1>{{index $.Translations "admin.remote_nodes.title"}} · {{.AdminTenant.Name}}</h1>
      <p class="remote-node-live-indicator">{{index $.Translations "admin.remote_nodes.websocket_live"}}</p>
    </div>
    <a href="/admin/tenants" class="button button-secondary">{{index $.Translations "admin.remote_nodes.back_to_tenants"}}</a>
  </div>

  <form method="post" action="/admin/tenants/{{.AdminTenant.ID}}/remote-nodes/create" class="admin-form admin-panel card stack remote-node-create-form">
    <div class="inline-grid">
      <label>
        <span>{{index $.Translations "admin.remote_nodes.name_label"}}</span>
        <input type="text" name="name" placeholder="{{index $.Translations "admin.remote_nodes.name_placeholder"}}" required>
      </label>
      <label>
        <span>{{index $.Translations "admin.remote_nodes.heartbeat_timeout_label"}}</span>
        <input type="number" name="heartbeat_timeout_seconds" min="30" value="120" required>
      </label>
    </div>
    <div class="form-actions">
      <button class="button" type="submit">{{index $.Translations "admin.remote_nodes.create_button"}}</button>
    </div>
  </form>

  <section class="remote-node-list" id="remote-nodes-body" aria-label="{{index $.Translations "admin.remote_nodes.title"}}">
    {{if .RemoteNodes}}
    {{range .RemoteNodes}}
    <article class="remote-node-card" data-node-id="{{.NodeID}}">
      <header class="remote-node-card-header">
        <div class="remote-node-title">
          <h2>{{.Name}}</h2>
          <code>{{.NodeID}}</code>
        </div>
        <div data-role="status">{{if .Online}}<span class="status-badge status-badge-success">{{index $.Translations "admin.remote_nodes.online"}}</span>{{else}}<span class="status-badge status-badge-muted">{{index $.Translations "admin.remote_nodes.offline"}}</span>{{end}}</div>
      </header>
      <div class="remote-node-meta-grid">
        <div class="remote-node-meta">
          <span>{{index $.Translations "admin.remote_nodes.last_seen_label"}}</span>
          <strong data-role="last-seen">{{if .LastSeenAtRaw}}<span class="js-relative-age" data-utc="{{.LastSeenAtRaw}}">{{.LastSeenAt}}</span>{{else}}—{{end}}</strong>
        </div>
        <div class="remote-node-meta">
          <span>{{index $.Translations "admin.remote_nodes.timeout_label"}}</span>
          <strong>{{.HeartbeatWindow}}</strong>
        </div>
      </div>
      <div class="remote-node-card-body">
        <section class="remote-node-log-section">
          <h3>{{index $.Translations "admin.remote_nodes.protocol_label"}}</h3>
          <div data-role="logs">
            {{if .Events}}
            <details class="remote-node-log">
              <summary>{{len .Events}} {{index $.Translations "admin.remote_nodes.entries"}}</summary>
              <ul class="remote-node-log-list">
                {{range .Events}}
                <li>
                  <div><strong>{{.EventLabel}}</strong> · <span class="js-relative-age" data-utc="{{.OccurredAtRaw}}">{{.OccurredAt}}</span></div>
                  <div class="muted compact break-all">{{index $.Translations "admin.remote_nodes.from"}} {{.SourceIP}}{{if .Details}} · {{.Details}}{{end}}{{if .UserAgent}} · {{.UserAgent}}{{end}}</div>
                </li>
                {{end}}
              </ul>
            </details>
            {{else}}
            <span class="muted">—</span>
            {{end}}
          </div>
        </section>
        <div class="admin-actions-inline remote-node-actions">
          <form method="post" action="/admin/tenants/{{$.AdminTenant.ID}}/remote-nodes/{{.NodeID}}/rotate-bootstrap" class="inline-form" data-confirm="{{index $.Translations "admin.remote_nodes.rotate_bootstrap_confirm"}}">
            <button class="button button-secondary button-small" type="submit">{{index $.Translations "admin.remote_nodes.rotate_bootstrap_button"}}</button>
          </form>
          <form method="post" action="/admin/tenants/{{$.AdminTenant.ID}}/remote-nodes/{{.NodeID}}/delete" class="inline-form" data-confirm="{{index $.Translations "admin.remote_nodes.delete_with_reassign_confirm"}}">
            <button class="button button-danger button-small" type="submit">{{index $.Translations "admin.remote_nodes.delete_button"}}</button>
          </form>
        </div>
      </div>
    </article>
    {{end}}
    {{else}}
    <div class="remote-node-empty muted">{{index $.Translations "admin.remote_nodes.no_remote_nodes"}}</div>
    {{end}}
  </section>
</div>
{{end}}

{{define "page_scripts"}}
<script src="/static/settings-remote-nodes.js" defer></script>
{{end}}
