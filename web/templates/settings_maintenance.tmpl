{{define "content"}}
{{$m := .MaintenanceAdm}}
<div class="admin-section settings-section" id="maintenance-page">
  <nav class="admin-nav settings-nav" aria-label="{{index $.Translations "layout.settings_title"}}">
    <a href="{{$.AppBase}}" class="admin-nav-link">{{index $.Translations "settings.nav.dashboard"}}</a>
    <a href="{{$.AppBase}}settings/profile" class="admin-nav-link">{{index $.Translations "settings.nav.profile"}}</a>
    <a href="{{$.AppBase}}settings/users" class="admin-nav-link">{{index $.Translations "settings.nav.users"}}</a>
    <a href="{{$.AppBase}}settings/webhooks" class="admin-nav-link">{{index $.Translations "settings.nav.webhooks"}}</a>
    <a href="{{$.AppBase}}settings/providers" class="admin-nav-link">{{index $.Translations "settings.nav.oidc_providers"}}</a>
    <a href="{{$.AppBase}}settings/remote-nodes" class="admin-nav-link">{{index $.Translations "settings.nav.remote_nodes"}}</a>
    <a href="{{$.AppBase}}settings/status-page" class="admin-nav-link">{{index $.Translations "settings.nav.status_page"}}</a>
    <a href="{{$.AppBase}}settings/maintenance" class="admin-nav-link is-active">{{index $.Translations "settings.nav.maintenance"}}</a>
  </nav>

  {{if .Notice}}<div class="notice success">{{.Notice}}</div>{{end}}
  {{if .Error}}<div class="notice error">{{.Error}}</div>{{end}}

  <div class="admin-header settings-header">
    <div>
      <h1>{{index $.Translations "settings.maintenance.title"}}</h1>
      <p class="muted compact">{{index $.Translations "settings.maintenance.subtitle"}}</p>
    </div>
  </div>

  <section class="card stack settings-panel">
    {{if $m.Rows}}
    <div class="table-wrap">
      <table class="admin-table">
        <caption class="sr-only">{{index $.Translations "settings.maintenance.title"}}</caption>
        <thead>
          <tr>
            <th scope="col">{{index $.Translations "settings.maintenance.col_title"}}</th>
            <th scope="col">{{index $.Translations "settings.maintenance.col_state"}}</th>
            <th scope="col">{{index $.Translations "settings.maintenance.col_time"}}</th>
            <th scope="col">{{index $.Translations "settings.maintenance.col_scope"}}</th>
            <th scope="col"><span class="sr-only">{{index $.Translations "common.edit"}}</span></th>
          </tr>
        </thead>
        <tbody>
          {{range $m.Rows}}
          <tr>
            <td><strong>{{.Title}}</strong>{{if .Description}}<br><span class="muted compact">{{.Description}}</span>{{end}}</td>
            <td><span class="maintenance-state maintenance-state-{{.State}}">{{index $.Translations (printf "settings.maintenance.state_%s" .State)}}</span></td>
            <td>
              <time class="maint-time" datetime="{{.StartsRaw}}">{{.StartsLabel}}</time> –
              <time class="maint-time" datetime="{{.EndsRaw}}">{{.EndsLabel}}</time>
              {{if ne .Recurrence "none"}}<br><span class="muted compact">{{index $.Translations (printf "settings.maintenance.recurrence_%s" .Recurrence)}}</span>{{end}}
            </td>
            <td>
              {{if eq .Scope "all"}}{{index $.Translations "settings.maintenance.scope_all"}}{{else}}{{.Targets}}{{end}}
            </td>
            <td class="table-actions">
              <a class="button button-secondary button-small" href="{{$.AppBase}}settings/maintenance?edit={{.ID}}#maintenance-form">{{index $.Translations "common.edit"}}</a>
              <form method="POST" action="{{$.AppBase}}settings/maintenance/{{.ID}}/delete" class="inline-form" data-confirm="{{index $.Translations "settings.maintenance.delete_confirm"}}">
                <button type="submit" class="button button-secondary button-small">{{index $.Translations "common.delete"}}</button>
              </form>
            </td>
          </tr>
          {{end}}
        </tbody>
      </table>
    </div>
    {{else}}
    <p class="muted">{{index $.Translations "settings.maintenance.none"}}</p>
    {{end}}
  </section>

  <form method="POST" action="{{$.AppBase}}settings/maintenance/save" class="admin-form card stack settings-panel" id="maintenance-form">
    <h2>{{if $m.Editing}}{{index $.Translations "settings.maintenance.edit_heading"}}{{else}}{{index $.Translations "settings.maintenance.new_heading"}}{{end}}</h2>
    <input type="hidden" name="id" value="{{if $m.Editing}}{{$m.Form.ID}}{{end}}">
    <label>
      <span>{{index $.Translations "settings.maintenance.field_title"}}</span>
      <input type="text" name="title" maxlength="120" required value="{{$m.Form.Title}}">
    </label>
    <label>
      <span>{{index $.Translations "settings.maintenance.field_description"}}</span>
      <textarea name="description" rows="2" maxlength="1000">{{$m.Form.Description}}</textarea>
    </label>
    <div class="inline-grid">
      <label>
        <span>{{index $.Translations "settings.maintenance.field_starts"}}</span>
        <input type="datetime-local" name="starts_local" required data-utc="{{$m.Form.StartsRaw}}">
        <input type="hidden" name="starts_at" value="{{$m.Form.StartsRaw}}">
      </label>
      <label>
        <span>{{index $.Translations "settings.maintenance.field_ends"}}</span>
        <input type="datetime-local" name="ends_local" required data-utc="{{$m.Form.EndsRaw}}">
        <input type="hidden" name="ends_at" value="{{$m.Form.EndsRaw}}">
      </label>
    </div>
    <p class="muted compact">{{index $.Translations "settings.maintenance.timezone_hint"}} <strong id="maintenance-tz">UTC</strong></p>
    <label>
      <span>{{index $.Translations "settings.maintenance.field_recurrence"}}</span>
      <select name="recurrence">
        <option value="none" {{if eq $m.Form.Recurrence "none"}}selected{{end}}>{{index $.Translations "settings.maintenance.recurrence_none"}}</option>
        <option value="daily" {{if eq $m.Form.Recurrence "daily"}}selected{{end}}>{{index $.Translations "settings.maintenance.recurrence_daily"}}</option>
        <option value="weekly" {{if eq $m.Form.Recurrence "weekly"}}selected{{end}}>{{index $.Translations "settings.maintenance.recurrence_weekly"}}</option>
      </select>
      <small class="muted compact">{{index $.Translations "settings.maintenance.recurrence_hint"}}</small>
    </label>
    <label>
      <span>{{index $.Translations "settings.maintenance.field_scope"}}</span>
      <select name="scope" id="maintenance-scope">
        <option value="all" {{if eq $m.Form.Scope "all"}}selected{{end}}>{{index $.Translations "settings.maintenance.scope_all"}}</option>
        <option value="groups" {{if eq $m.Form.Scope "groups"}}selected{{end}}>{{index $.Translations "settings.maintenance.scope_groups"}}</option>
        <option value="monitors" {{if eq $m.Form.Scope "monitors"}}selected{{end}}>{{index $.Translations "settings.maintenance.scope_monitors"}}</option>
      </select>
    </label>
    <fieldset class="stack" data-scope-section="groups">
      <legend>{{index $.Translations "settings.maintenance.scope_groups"}}</legend>
      {{range $m.Groups}}
      <label class="checkbox-row"><input type="checkbox" name="group" value="{{.Name}}" {{if .Selected}}checked{{end}}><span>{{.Name}}</span></label>
      {{else}}
      <p class="muted compact">{{index $.Translations "settings.maintenance.no_groups"}}</p>
      {{end}}
    </fieldset>
    <fieldset class="stack" data-scope-section="monitors">
      <legend>{{index $.Translations "settings.maintenance.scope_monitors"}}</legend>
      {{range $m.Monitors}}
      <label class="checkbox-row"><input type="checkbox" name="monitor_id" value="{{.ID}}" {{if .Selected}}checked{{end}}><span>{{.Name}}{{if .Group}} <span class="muted">· {{.Group}}</span>{{end}}</span></label>
      {{else}}
      <p class="muted compact">{{index $.Translations "settings.maintenance.no_monitors"}}</p>
      {{end}}
    </fieldset>
    <div class="form-actions">
      <button type="submit" class="button">{{index $.Translations "common.save"}}</button>
      {{if $m.Editing}}<a class="button button-secondary" href="{{$.AppBase}}settings/maintenance">{{index $.Translations "dashboard.modal.cancel_button"}}</a>{{end}}
    </div>
  </form>
</div>
{{end}}

{{define "page_scripts"}}
<script src="/static/settings-maintenance.js?v={{$.AssetVersion}}" defer></script>
{{end}}
