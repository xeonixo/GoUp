{{define "content"}}
<div class="admin-section admin-console">
  {{template "admin_nav" .}}

  {{if .Notice}}<div class="notice success">{{.Notice}}</div>{{end}}
  {{if .Error}}<div class="notice error">{{.Error}}</div>{{end}}

  <div class="admin-header admin-page-header">
    <div>
      <h1>{{index $.Translations "admin.remote_nodes.title"}}</h1>
    </div>
  </div>

  <div class="card table-card admin-table-card">
    <table class="admin-table">
      <thead>
        <tr>
          <th scope="col">{{index $.Translations "admin.users.tenant"}}</th>
          <th scope="col">{{index $.Translations "admin.remote_nodes.name_label"}}</th>
          <th scope="col">{{index $.Translations "admin.remote_nodes.node_id_label"}}</th>
          <th scope="col">{{index $.Translations "admin.remote_nodes.status_label"}}</th>
          <th scope="col">{{index $.Translations "admin.remote_nodes.last_seen_label"}}</th>
          <th scope="col">{{index $.Translations "admin.remote_nodes.version_label"}}</th>
          <th scope="col">{{index $.Translations "admin.remote_nodes.timeout_label"}}</th>
          <th scope="col">{{index $.Translations "admin.remote_nodes.actions_label"}}</th>
        </tr>
      </thead>
      <tbody>
        {{if .AdminRemoteNodeRows}}
        {{range .AdminRemoteNodeRows}}
        <tr>
          <td><strong>{{.TenantName}}</strong></td>
          <td>{{.Name}}</td>
          <td class="break-all"><code>{{.NodeID}}</code></td>
          <td>{{if .Online}}<span class="status-badge status-badge-success">ONLINE</span>{{else}}<span class="status-badge status-badge-muted">OFFLINE</span>{{end}}</td>
          <td>{{if .LastSeenAtRaw}}<span class="js-relative-age" data-utc="{{.LastSeenAtRaw}}">{{.LastSeenAt}}</span>{{else}}—{{end}}</td>
          <td>{{if .AgentVersion}}<code>{{.AgentVersion}}</code>{{if .VersionOutdated}} <span class="status-badge status-badge-warning" title="{{printf (index $.Translations "admin.remote_nodes.version_outdated_title") .ServerVersion .AgentVersion}}">{{index $.Translations "admin.remote_nodes.version_outdated"}}</span>{{end}}{{else}}—{{end}}</td>
          <td>{{.HeartbeatWindow}}</td>
          <td class="admin-actions-inline">
            <a href="/admin/tenants/{{.TenantID}}/remote-nodes" class="button button-secondary button-small">{{index $.Translations "admin.users.open_tenant"}}</a>
          </td>
        </tr>
        {{end}}
        {{else}}
        <tr>
          <td colspan="8" class="muted admin-empty-row">{{index $.Translations "admin.remote_nodes.no_remote_nodes"}}</td>
        </tr>
        {{end}}
      </tbody>
    </table>
  </div>
</div>
{{end}}
