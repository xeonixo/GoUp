{{define "content"}}
{{$hasMatrix := or .ProfileNotify.MatrixEnabled .ProfileNotify.MatrixHomeserver .ProfileNotify.MatrixRoomID}}
<div class="admin-section settings-section">
  <nav class="admin-nav settings-nav" aria-label="{{index $.Translations "layout.settings_title"}}">
    <a href="{{$.AppBase}}" class="admin-nav-link">{{index $.Translations "settings.nav.dashboard"}}</a>
    <a href="{{$.AppBase}}settings/profile" class="admin-nav-link is-active">{{index $.Translations "settings.nav.profile"}}</a>
    {{if eq $.User.Role "admin"}}
    <a href="{{$.AppBase}}settings/users" class="admin-nav-link">{{index $.Translations "settings.nav.users"}}</a>
    <a href="{{$.AppBase}}settings/webhooks" class="admin-nav-link">{{index $.Translations "settings.nav.webhooks"}}</a>
    <a href="{{$.AppBase}}settings/providers" class="admin-nav-link">{{index $.Translations "settings.nav.oidc_providers"}}</a>
    <a href="{{$.AppBase}}settings/remote-nodes" class="admin-nav-link">{{index $.Translations "settings.nav.remote_nodes"}}</a>
    <a href="{{$.AppBase}}settings/status-page" class="admin-nav-link">{{index $.Translations "settings.nav.status_page"}}</a>
    {{end}}
  </nav>

  {{if .Notice}}<div class="notice success">{{.Notice}}</div>{{end}}
  {{if .Error}}<div class="notice error">{{.Error}}</div>{{end}}

  <div class="admin-header settings-header">
    <div>
      <h1>{{index $.Translations "settings.profile.title"}}</h1>
    </div>
  </div>

  <form method="POST" action="{{$.AppBase}}settings/profile/save" class="stack settings-grid settings-panel-grid">
    <section class="card stack admin-form settings-card settings-panel">
      <div class="settings-card-header">
        <div>
          <h2>{{index $.Translations "settings.profile.title"}}</h2>
          <p class="muted compact">{{index $.Translations "settings.profile.subtitle"}}</p>
        </div>
      </div>
      <div class="form-group">
        <label for="display_name">{{index $.Translations "settings.profile.display_name_label"}}</label>
        <input id="display_name" name="display_name" type="text" value="{{.ProfileUser.DisplayName}}" required>
      </div>
      <div class="form-group">
        <label for="email">{{index $.Translations "settings.profile.email_label"}}</label>
        <input id="email" name="email" type="email" value="{{.ProfileUser.Email}}">
      </div>
      <div class="form-group">
        <label for="preferred_language">{{index $.Translations "settings.profile.language_label"}}</label>
        <select id="preferred_language" name="preferred_language">
          {{range .LanguageOptions}}
          <option value="{{.Code}}" {{if .Selected}}selected{{end}}>{{.Label}}</option>
          {{end}}
        </select>
      </div>
      <div class="form-group">
        <label for="theme_preference">{{index $.Translations "settings.profile.theme_label"}}</label>
        <select id="theme_preference" data-theme-select>
          <option value="auto">{{index $.Translations "settings.profile.theme_auto"}}</option>
          <option value="light">{{index $.Translations "settings.profile.theme_light"}}</option>
          <option value="dark">{{index $.Translations "settings.profile.theme_dark"}}</option>
        </select>
        <p class="muted compact">{{index $.Translations "settings.profile.theme_hint"}}</p>
      </div>
    </section>

    <section class="card stack admin-form settings-card settings-panel">
      <div class="settings-card-header">
        <div>
          <h2>{{index $.Translations "settings.notifications.title"}}</h2>
          <p class="muted compact">{{index $.Translations "settings.notifications.subtitle"}}</p>
        </div>
        <details class="action-menu settings-add-menu">
          <summary class="action-menu-trigger" aria-label="{{index $.Translations "settings.notifications.add_channel"}}">＋</summary>
          <div class="action-menu-list">
            <button class="action-menu-item" type="button" data-add-notifier="matrix" {{if $hasMatrix}}disabled{{end}}>{{index $.Translations "settings.notifications.add_matrix"}}</button>
          </div>
        </details>
      </div>

      <section class="settings-channel-card">
        <div class="settings-channel-header">
          <div>
            <h3>{{index $.Translations "settings.notifications.email.title"}}</h3>
            <p class="muted compact">{{index $.Translations "settings.notifications.email.subtitle"}}</p>
          </div>
          <span class="status-badge {{if .ProfileNotify.EmailEnabled}}status-badge-success{{else}}status-badge-muted{{end}}">{{if .ProfileNotify.EmailEnabled}}{{index $.Translations "settings.notifications.status.active"}}{{else}}{{index $.Translations "settings.notifications.status.off"}}{{end}}</span>
        </div>
        <label class="checkbox-row">
          <input type="checkbox" name="email_enabled" {{if .ProfileNotify.EmailEnabled}}checked{{end}}>
          <span>{{index $.Translations "settings.notifications.email.enabled"}}</span>
        </label>
        <div class="form-actions">
          <button type="submit" class="button button-secondary button-small" formaction="{{$.AppBase}}settings/profile/notifiers/email/test" formmethod="POST">{{index $.Translations "settings.notifications.test_button"}}</button>
        </div>
      </section>

      <div class="settings-channel-list">
        <section class="settings-channel-card" id="matrix-channel-card" {{if not $hasMatrix}}hidden{{end}}>
          <div class="settings-channel-header">
            <div>
              <h3>{{index $.Translations "settings.notifications.matrix.title"}}</h3>
              <p class="muted compact">{{index $.Translations "settings.notifications.matrix.subtitle"}}</p>
            </div>
            <div class="settings-inline-actions">
              <span class="status-badge {{if .ProfileNotify.MatrixEnabled}}status-badge-success{{else}}status-badge-muted{{end}}">{{if .ProfileNotify.MatrixEnabled}}{{index $.Translations "settings.notifications.status.active"}}{{else}}{{index $.Translations "settings.notifications.status.draft"}}{{end}}</span>
              <form method="POST" action="{{$.AppBase}}settings/profile/notifiers/delete" class="inline-form" data-confirm="{{index $.Translations "settings.notifications.matrix.remove_confirm"}}">
                <input type="hidden" name="kind" value="matrix">
                <button type="submit" class="button button-secondary button-small">{{index $.Translations "settings.notifications.matrix.remove"}}</button>
              </form>
            </div>
          </div>
          <div class="inline-grid">
            <div class="form-group">
              <label for="matrix_homeserver_url">{{index $.Translations "settings.notifications.matrix.homeserver_url"}}</label>
              <input id="matrix_homeserver_url" name="matrix_homeserver_url" type="url" value="{{.ProfileNotify.MatrixHomeserver}}" placeholder="{{index $.Translations "settings.notifications.matrix.homeserver_url_placeholder"}}">
            </div>
            <div class="form-group">
              <label for="matrix_room_id">{{index $.Translations "settings.notifications.matrix.room_id"}}</label>
              <input id="matrix_room_id" name="matrix_room_id" type="text" value="{{.ProfileNotify.MatrixRoomID}}" placeholder="{{index $.Translations "settings.notifications.matrix.room_id_placeholder"}}">
            </div>
          </div>
          <div class="form-group">
            <label for="matrix_access_token">{{index $.Translations "settings.notifications.matrix.access_token"}}</label>
            <input id="matrix_access_token" name="matrix_access_token" type="password" placeholder="{{index $.Translations "settings.notifications.matrix_access_token_placeholder"}}">
          </div>
          <label class="checkbox-row">
            <input type="checkbox" name="matrix_enabled" {{if .ProfileNotify.MatrixEnabled}}checked{{end}}>
            <span>{{index $.Translations "settings.notifications.matrix.enabled"}}</span>
          </label>
          <div class="form-actions">
            <button type="submit" class="button button-secondary button-small" formaction="{{$.AppBase}}settings/profile/notifiers/matrix/test" formmethod="POST">{{index $.Translations "settings.notifications.test_button"}}</button>
          </div>
        </section>

        <section class="settings-empty-state" id="notifier-empty-state" {{if $hasMatrix}}hidden{{end}}>
          <p class="muted">{{index $.Translations "settings.notifications.no_channels"}}</p>
        </section>
      </div>

      <div class="form-actions">
        <button type="submit" class="button">{{index $.Translations "common.save"}}</button>
      </div>
    </section>
  </form>

  <section class="card stack admin-form settings-card settings-panel push-panel" id="push-panel"
    data-push-key-url="{{$.AppBase}}settings/push/key"
    data-push-subscribe-url="{{$.AppBase}}settings/push/subscribe"
    data-push-unsubscribe-url="{{$.AppBase}}settings/push/unsubscribe"
    data-push-test-url="{{$.AppBase}}settings/push/test"
    data-push-prefs-url="{{$.AppBase}}settings/push/prefs"
    data-msg-checking="{{index $.Translations "settings.push.status.checking"}}"
    data-msg-unsupported="{{index $.Translations "settings.push.status.unsupported"}}"
    data-msg-install-ios="{{index $.Translations "settings.push.status.install_ios"}}"
    data-msg-insecure="{{index $.Translations "settings.push.status.insecure"}}"
    data-msg-denied="{{index $.Translations "settings.push.status.denied"}}"
    data-msg-active="{{index $.Translations "settings.push.status.active"}}"
    data-msg-inactive="{{index $.Translations "settings.push.status.inactive"}}"
    data-msg-stale="{{index $.Translations "settings.push.status.stale"}}"
    data-msg-enabled="{{index $.Translations "settings.push.message.enabled"}}"
    data-msg-disabled="{{index $.Translations "settings.push.message.disabled"}}"
    data-msg-removed="{{index $.Translations "settings.push.message.removed"}}"
    data-msg-test-sent="{{index $.Translations "settings.push.message.test_sent"}}"
    data-msg-test-failed="{{index $.Translations "settings.push.message.test_failed"}}"
    data-msg-rate-limited="{{index $.Translations "settings.push.message.rate_limited"}}"
    data-msg-limit="{{index $.Translations "settings.push.message.limit"}}"
    data-msg-no-devices="{{index $.Translations "settings.push.message.no_devices"}}"
    data-msg-error="{{index $.Translations "settings.push.message.error"}}">
    <div class="settings-card-header">
      <div>
        <h2>{{index $.Translations "settings.push.title"}}</h2>
        <p class="muted compact">{{index $.Translations "settings.push.subtitle"}}</p>
      </div>
    </div>
    <p class="push-status" data-push-status role="status" aria-live="polite">{{index $.Translations "settings.push.status.checking"}}</p>
    <div class="form-actions">
      <button type="button" class="button button-small" data-push-enable hidden>{{index $.Translations "settings.push.button.enable"}}</button>
      <button type="button" class="button button-secondary button-small" data-push-disable hidden>{{index $.Translations "settings.push.button.disable"}}</button>
      <button type="button" class="button button-secondary button-small" data-push-test {{if not .PushDevices}}disabled{{end}}>{{index $.Translations "settings.push.button.test"}}</button>
    </div>

    <h3>{{index $.Translations "settings.push.devices"}}</h3>
    {{if .PushDevices}}
    <ul class="push-device-list">
      {{range .PushDevices}}
      <li class="push-device" data-push-device data-id="{{.ID}}" data-endpoint="{{.Endpoint}}">
        <div class="push-device-head">
          <strong>{{if .Label}}{{.Label}}{{else}}?{{end}}</strong>
          <span class="status-badge status-badge-success push-this-device" data-push-this-device hidden>{{index $.Translations "settings.push.this_device"}}</span>
          <button type="button" class="button button-secondary button-small" data-push-remove>{{index $.Translations "settings.push.button.remove"}}</button>
        </div>
        <p class="muted compact">
          {{index $.Translations "settings.push.registered"}}: {{.Created}} ·
          {{index $.Translations "settings.push.last_success"}}: {{if .LastSuccess}}{{.LastSuccess}}{{else}}{{index $.Translations "settings.push.never"}}{{end}}
          {{if .LastError}}<br>{{index $.Translations "settings.push.last_error"}}: {{.LastError}}{{end}}
        </p>
        <div class="push-categories">
          <label class="checkbox-row"><input type="checkbox" data-push-pref="down" {{if .Down}}checked{{end}}><span>{{index $.Translations "settings.push.category.down"}}</span></label>
          <label class="checkbox-row"><input type="checkbox" data-push-pref="recovery" {{if .Recovery}}checked{{end}}><span>{{index $.Translations "settings.push.category.recovery"}}</span></label>
          <label class="checkbox-row"><input type="checkbox" data-push-pref="degraded" {{if .Degraded}}checked{{end}}><span>{{index $.Translations "settings.push.category.degraded"}}</span></label>
          <label class="checkbox-row"><input type="checkbox" data-push-pref="reminder" {{if .Reminder}}checked{{end}}><span>{{index $.Translations "settings.push.category.reminder"}}</span></label>
        </div>
      </li>
      {{end}}
    </ul>
    {{else}}
    <p class="muted compact">{{index $.Translations "settings.push.devices_empty"}}</p>
    {{end}}
  </section>

  {{if .ProfileNotify.HasLocalCredentials}}
  <form method="POST" action="{{$.AppBase}}settings/profile/password" class="card stack admin-form settings-panel" autocomplete="on">
    <h2>{{index $.Translations "settings.password.title"}}</h2>
    <div class="form-group">
      <label for="current_password">{{index $.Translations "settings.password.current_label"}}</label>
      <input id="current_password" name="current_password" type="password" required autocomplete="current-password" enterkeyhint="next">
    </div>
    <div class="form-group">
      <label for="new_password">{{index $.Translations "settings.password.new_label"}}</label>
      <input id="new_password" name="new_password" type="password" required autocomplete="new-password" enterkeyhint="next">
    </div>
    <div class="form-group">
      <label for="confirm_password">{{index $.Translations "settings.password.confirm_label"}}</label>
      <input id="confirm_password" name="confirm_password" type="password" required autocomplete="new-password" enterkeyhint="go">
    </div>
    <div class="form-actions">
      <button type="submit" class="button button-secondary">{{index $.Translations "settings.password.update_button"}}</button>
    </div>
  </form>
  {{else}}
  <div class="card notice">
    {{index $.Translations "settings.password.sso_notice"}}
  </div>
  {{end}}
</div>

{{end}}

{{define "page_scripts"}}
<script src="/static/settings-profile.js?v={{$.AssetVersion}}" defer></script>
{{end}}
