{{define "content"}}
{{with .MonitorDetail}}
<div class="admin-section monitor-detail">
  {{if $.Notice}}<div class="notice success">{{$.Notice}}</div>{{end}}
  {{if $.Error}}<div class="notice error">{{$.Error}}</div>{{end}}
  <nav class="admin-nav card">
    <a href="{{$.AppBase}}" class="admin-nav-link">← {{index $.Translations "settings.nav.dashboard"}}</a>
  </nav>

  <div class="admin-header monitor-detail-header">
    <div>
      <h1>{{.Monitor.Name}}</h1>
      <p class="muted compact">{{.Monitor.Kind}}{{if .Monitor.TLSMode}} / {{.Monitor.TLSMode}}{{end}} · {{.Monitor.Group}} · <span class="break-all">{{.Monitor.Target}}</span></p>
    </div>
    <div class="monitor-detail-status">
      {{if .Monitor.Muted}}<span class="muted-badge" title="{{index $.Translations "dashboard.monitor.muted_until"}} {{.Monitor.MutedUntilLabel}}">🔕 {{index $.Translations "dashboard.monitor.muted_until"}} {{.Monitor.MutedUntilLabel}}</span>{{end}}
      <span class="status-pill {{.Monitor.StatusClass}}"{{if .Monitor.InMaintenance}} title="{{.Monitor.MaintenanceTitle}}"{{end}}>{{if .Monitor.InMaintenance}}{{index $.Translations "status.maintenance"}}{{else}}{{.Monitor.StatusLabel}}{{end}}</span>
    </div>
  </div>

  {{if .Monitor.HeartbeatURL}}
  <section class="card stack heartbeat-info">
    <h3>{{index $.Translations "monitor_detail.heartbeat_title"}}</h3>
    <p class="muted compact">{{index $.Translations "monitor_detail.heartbeat_intro"}}</p>
    <label>
      <span>{{index $.Translations "dashboard.modal.heartbeat_url_label"}}</span>
      <input type="text" id="heartbeat-url" class="heartbeat-copy-field" readonly value="{{.Monitor.HeartbeatURL}}">
    </label>
    <button class="button button-secondary button-small" type="button" data-action="copy" data-copy-target="heartbeat-url" data-copied-label="{{index $.Translations "dashboard.modal.heartbeat_copied"}}">{{index $.Translations "dashboard.modal.heartbeat_copy"}}</button>
    <label>
      <span>{{index $.Translations "dashboard.modal.heartbeat_curl_label"}}</span>
      <input type="text" id="heartbeat-curl" class="heartbeat-copy-field" readonly value="{{.Monitor.HeartbeatCurl}}">
    </label>
    <button class="button button-secondary button-small" type="button" data-action="copy" data-copy-target="heartbeat-curl" data-copied-label="{{index $.Translations "dashboard.modal.heartbeat_copied"}}">{{index $.Translations "dashboard.modal.heartbeat_copy"}}</button>
    <label>
      <span>{{index $.Translations "dashboard.modal.heartbeat_curl_fail_label"}}</span>
      <input type="text" id="heartbeat-curl-fail" class="heartbeat-copy-field" readonly value="{{.Monitor.HeartbeatCurlFail}}">
    </label>
    <button class="button button-secondary button-small" type="button" data-action="copy" data-copy-target="heartbeat-curl-fail" data-copied-label="{{index $.Translations "dashboard.modal.heartbeat_copied"}}">{{index $.Translations "dashboard.modal.heartbeat_copy"}}</button>
    <form method="post" action="{{$.AppBase}}monitors/heartbeat/regenerate" data-confirm="{{index $.Translations "dashboard.modal.heartbeat_regenerate_confirm"}}">
      <input type="hidden" name="id" value="{{.Monitor.ID}}">
      <button class="button button-secondary button-small" type="submit">{{index $.Translations "dashboard.modal.heartbeat_regenerate"}}</button>
    </form>
  </section>
  {{end}}

  <section class="stats-grid monitor-detail-uptime">
    {{range .Uptime}}
    <article class="card stat-card uptime-tile {{.Class}}">
      <h2>{{index $.Translations "monitor_detail.uptime"}} · {{.Label}}</h2>
      <div class="metric">{{.Percent}}</div>
      <p class="muted compact">Ø {{.AvgLatency}}{{if .P95Latency}} · P95 {{.P95Latency}}{{end}} · {{.Checks}} Checks</p>
    </article>
    {{end}}
  </section>

  <section class="card stack">
    <h3>{{index $.Translations "monitor_detail.last_90_days"}}</h3>
    <div class="trend-bars trend-bars-large detail-day-bars">
      {{range .DayBars}}<span class="trend-bar {{.Class}}" title="{{.Label}}"></span>{{end}}
    </div>
  </section>

  <section class="card stack">
    <h3>{{index $.Translations "monitor_detail.latency_365"}}</h3>
    {{if .Latency.HasData}}
    <div class="detail-latency-chart">
      <div class="detail-latency-axis-y" aria-hidden="true"><span>{{.Latency.MaxLabel}}</span><span>{{.Latency.MidLabel}}</span><span>0 ms</span></div>
      <svg viewBox="0 0 {{.Latency.Width}} {{.Latency.Height}}" preserveAspectRatio="none" role="img" aria-label="{{index $.Translations "monitor_detail.latency_365"}}">
        <polyline class="detail-latency-line" points="{{.Latency.Polyline}}" fill="none" vector-effect="non-scaling-stroke"></polyline>
      </svg>
    </div>
    <div class="detail-latency-axis-x muted compact"><span>{{.Latency.StartLabel}}</span><span>{{.Latency.EndLabel}}</span></div>
    {{else}}
    <p class="muted">{{index $.Translations "dashboard.trend_detail.no_data"}}</p>
    {{end}}
  </section>

  <section class="card stack">
    <h3>{{index $.Translations "monitor_detail.details"}}</h3>
    <dl class="detail-facts">
      <dt>{{index $.Translations "monitor_detail.last_check"}}</dt><dd>{{if .Monitor.LastCheckedAt}}{{.Monitor.LastCheckedAt}}{{else}}—{{end}}</dd>
      <dt>{{index $.Translations "monitor_detail.last_result"}}</dt><dd class="break-all">{{if .Monitor.LastMessage}}{{.Monitor.LastMessage}}{{else}}—{{end}}</dd>
      <dt>{{index $.Translations "monitor_detail.latency"}}</dt><dd>{{if .Monitor.LastLatency}}{{.Monitor.LastLatency}}{{else}}—{{end}}</dd>
      <dt>{{index $.Translations "monitor_detail.interval"}}</dt><dd>{{.Monitor.Interval}} / {{.Monitor.Timeout}}</dd>
      {{if .Monitor.TLSDaysRemaining}}<dt>{{index $.Translations "monitor_detail.certificate"}}</dt><dd>{{.Monitor.TLSDaysRemaining}} · {{.Monitor.TLSNotAfter}} ({{index $.Translations "monitor_detail.warning_at"}} {{.Monitor.CertWarningDays}})</dd>{{end}}
    </dl>
  </section>

  <section class="card stack">
    <h3>{{index $.Translations "monitor_detail.incidents"}}</h3>
    {{if .Incidents}}
    <div class="table-wrap">
      <table>
        <thead><tr>
          <th scope="col">{{index $.Translations "monitor_detail.incident_start"}}</th>
          <th scope="col">{{index $.Translations "monitor_detail.incident_end"}}</th>
          <th scope="col">{{index $.Translations "monitor_detail.incident_duration"}}</th>
          <th scope="col">{{index $.Translations "monitor_detail.incident_cause"}}</th>
        </tr></thead>
        <tbody>
          {{range .Incidents}}
          <tr>
            <td>{{.Started}}</td>
            <td>{{if .Open}}<span class="status-pill status-DOWN">{{index $.Translations "monitor_detail.incident_open"}}</span>{{else}}{{.Resolved}}{{end}}</td>
            <td>{{.Duration}}</td>
            <td class="break-all"><span class="event-message-cell">{{.Cause}}</span></td>
          </tr>
          {{end}}
        </tbody>
      </table>
    </div>
    {{else}}
    <p class="muted">{{index $.Translations "monitor_detail.no_incidents"}}</p>
    {{end}}
  </section>
</div>
{{end}}
{{end}}
