{{define "content"}}
{{$sp := .StatusAdmin}}
<div class="admin-section settings-section">
  <nav class="admin-nav settings-nav" aria-label="{{index $.Translations "layout.settings_title"}}">
    <a href="{{$.AppBase}}" class="admin-nav-link">{{index $.Translations "settings.nav.dashboard"}}</a>
    <a href="{{$.AppBase}}settings/profile" class="admin-nav-link">{{index $.Translations "settings.nav.profile"}}</a>
    <a href="{{$.AppBase}}settings/users" class="admin-nav-link">{{index $.Translations "settings.nav.users"}}</a>
    <a href="{{$.AppBase}}settings/webhooks" class="admin-nav-link">{{index $.Translations "settings.nav.webhooks"}}</a>
    <a href="{{$.AppBase}}settings/providers" class="admin-nav-link">{{index $.Translations "settings.nav.oidc_providers"}}</a>
    <a href="{{$.AppBase}}settings/remote-nodes" class="admin-nav-link">{{index $.Translations "settings.nav.remote_nodes"}}</a>
    <a href="{{$.AppBase}}settings/status-page" class="admin-nav-link is-active">{{index $.Translations "settings.nav.status_page"}}</a>
    <a href="{{$.AppBase}}settings/maintenance" class="admin-nav-link">{{index $.Translations "settings.nav.maintenance"}}</a>
    <a href="{{$.AppBase}}settings/reports" class="admin-nav-link">{{index $.Translations "settings.nav.reports"}}</a>
  </nav>

  {{if .Notice}}<div class="notice success">{{.Notice}}</div>{{end}}
  {{if .Error}}<div class="notice error">{{.Error}}</div>{{end}}

  <div class="admin-header settings-header">
    <div>
      <h1>{{index $.Translations "settings.status_page.title"}}</h1>
      <p class="muted compact">{{index $.Translations "settings.status_page.subtitle"}}</p>
    </div>
  </div>

  <form method="POST" action="{{$.AppBase}}settings/status-page/save" class="admin-form card stack settings-panel" enctype="multipart/form-data">
    <h2>{{index $.Translations "settings.status_page.page_heading"}}</h2>
    <label class="checkbox-row">
      <input type="checkbox" name="enabled" {{if $sp.Enabled}}checked{{end}}>
      <span>{{index $.Translations "settings.status_page.enabled"}}</span>
    </label>
    <p class="muted compact">{{index $.Translations "settings.status_page.enabled_hint"}}</p>
    <label>
      <span>{{index $.Translations "settings.status_page.page_title"}}</span>
      <input type="text" name="title" maxlength="120" value="{{$sp.Title}}">
    </label>
    <label>
      <span>{{index $.Translations "settings.status_page.description"}}</span>
      <textarea name="description" rows="3" maxlength="500">{{$sp.Description}}</textarea>
    </label>

    <h3>{{index $.Translations "settings.status_page.branding"}}</h3>
    <label>
      <span>{{index $.Translations "settings.status_page.logo"}}</span>
      <input type="file" name="logo_upload" accept="image/png,image/jpeg,image/webp,image/svg+xml,image/x-icon,.ico">
    </label>
    {{if $sp.HasLogo}}
    <label class="checkbox-row">
      <input type="checkbox" name="clear_logo">
      <span>{{index $.Translations "settings.status_page.clear_logo"}}</span>
    </label>
    {{end}}
    <label>
      <span>{{index $.Translations "settings.status_page.brand_color"}}</span>
      <input type="text" name="brand_color" maxlength="7" placeholder="#2563eb" value="{{$sp.BrandColor}}" pattern="#?[0-9A-Fa-f]{3}([0-9A-Fa-f]{3})?">
    </label>
    <label class="checkbox-row">
      <input type="checkbox" name="hide_goup_footer" {{if $sp.HideGoUpFooter}}checked{{end}}>
      <span>{{index $.Translations "settings.status_page.hide_goup_footer"}}</span>
    </label>
    <label class="checkbox-row">
      <input type="checkbox" name="noindex" {{if $sp.NoIndex}}checked{{end}}>
      <span>{{index $.Translations "settings.status_page.noindex"}}</span>
    </label>
    <label>
      <span>{{index $.Translations "settings.status_page.announce_hours"}}</span>
      <input type="number" name="announce_hours" min="1" max="720" step="1" value="{{$sp.AnnounceHours}}">
      <small class="muted compact">{{index $.Translations "settings.status_page.announce_hours_hint"}}</small>
    </label>
    <label>
      <span>{{index $.Translations "settings.status_page.custom_css"}}</span>
      <textarea name="custom_css" rows="8" maxlength="16384" spellcheck="false" placeholder="{{index $.Translations "settings.status_page.custom_css_placeholder"}}">{{$sp.CustomCSS}}</textarea>
      <small class="muted compact">{{index $.Translations "settings.status_page.custom_css_hint"}}</small>
    </label>
    <label>
      <span>{{index $.Translations "settings.status_page.custom_domain"}}</span>
      <input type="text" name="custom_domain" maxlength="253" placeholder="status.example.com" value="{{$sp.CustomDomain}}" autocomplete="off">
      <small class="muted compact">{{index $.Translations "settings.status_page.custom_domain_hint"}}</small>
    </label>

    <h3>{{index $.Translations "settings.status_page.access"}}</h3>
    <p class="muted compact">{{index $.Translations "settings.status_page.access_hint"}}</p>
    <label>
      <span>{{index $.Translations "settings.status_page.access_mode"}}</span>
      <select name="access_mode">
        <option value="public" {{if ne $sp.AccessMode "token"}}selected{{end}}>{{index $.Translations "settings.status_page.access_public"}}</option>
        <option value="token" {{if eq $sp.AccessMode "token"}}selected{{end}}>{{index $.Translations "settings.status_page.access_token"}}</option>
      </select>
    </label>
    <label class="checkbox-row">
      <input type="checkbox" name="regenerate_access_token">
      <span>{{index $.Translations "settings.status_page.regenerate_access_token"}}{{if $sp.HasAccessToken}} ({{index $.Translations "settings.status_page.access_token_present"}}){{end}}</span>
    </label>

    <h3>{{index $.Translations "settings.status_page.monitors"}}</h3>
    <p class="muted compact">{{index $.Translations "settings.status_page.monitors_hint"}}</p>
    {{if $sp.Monitors}}
    <ul class="status-admin-list">
      {{range $sp.Monitors}}
      <li class="status-admin-row">
        <label class="checkbox-row">
          <input type="checkbox" name="monitor_{{.ID}}" {{if .Selected}}checked{{end}}>
          <span>{{.Name}}{{if .Group}} <span class="muted">· {{.Group}}</span>{{end}}</span>
        </label>
        <input type="text" name="display_{{.ID}}" maxlength="120" value="{{.DisplayName}}" aria-label="{{index $.Translations "settings.status_page.display_name"}}" placeholder="{{index $.Translations "settings.status_page.display_name"}}">
      </li>
      {{end}}
    </ul>
    {{else}}
    <p class="muted">{{index $.Translations "settings.status_page.no_monitors"}}</p>
    {{end}}

    <div class="form-actions">
      <button type="submit" class="button">{{index $.Translations "common.save"}}</button>
    </div>
  </form>

  <section class="card stack settings-panel">
    <h2>{{index $.Translations "settings.status_page.public_url"}}</h2>
    <div class="status-url-row">
      <input type="text" id="status-public-url" readonly value="{{$sp.PublicURL}}">
      <button type="button" class="button button-secondary" data-action="copy" data-copy-target="status-public-url" data-copied-label="{{index $.Translations "settings.status_page.copied"}}">{{index $.Translations "settings.status_page.copy_url"}}</button>
      <a class="button button-secondary" href="{{$sp.PublicURL}}" target="_blank" rel="noopener noreferrer">{{index $.Translations "settings.status_page.open"}}</a>
    </div>
    {{if $sp.CustomDomainURL}}
    <p class="muted compact">{{index $.Translations "settings.status_page.custom_domain_url"}}</p>
    <div class="status-url-row">
      <input type="text" id="status-custom-domain-url" readonly value="{{$sp.CustomDomainURL}}">
      <button type="button" class="button button-secondary" data-action="copy" data-copy-target="status-custom-domain-url" data-copied-label="{{index $.Translations "settings.status_page.copied"}}">{{index $.Translations "settings.status_page.copy_url"}}</button>
      <a class="button button-secondary" href="{{$sp.CustomDomainURL}}" target="_blank" rel="noopener noreferrer">{{index $.Translations "settings.status_page.open"}}</a>
    </div>
    {{end}}
  </section>

  {{if $sp.NewAccessToken}}
  <section class="card stack settings-panel">
    <div class="notice warning stack">
      <strong>{{index $.Translations "settings.status_page.access_token_once"}}</strong>
      <div class="status-url-row">
        <input type="text" id="status-new-access-token" readonly value="{{$sp.NewAccessToken}}" autocomplete="off">
        <button type="button" class="button button-secondary" data-action="copy" data-copy-target="status-new-access-token" data-copied-label="{{index $.Translations "settings.status_page.copied"}}">{{index $.Translations "settings.status_page.copy_token"}}</button>
      </div>
    </div>
  </section>
  {{end}}

  <section class="card stack settings-panel">
    <h2>{{index $.Translations "settings.status_page.tokens_title"}}</h2>
    <p class="muted compact">{{index $.Translations "settings.status_page.tokens_hint"}}</p>

    {{if $sp.NewToken}}
    <div class="notice warning stack">
      <strong>{{index $.Translations "settings.status_page.token_once"}}</strong>
      <div class="status-url-row">
        <input type="text" id="status-new-token" readonly value="{{$sp.NewToken}}" autocomplete="off">
        <button type="button" class="button button-secondary" data-action="copy" data-copy-target="status-new-token" data-copied-label="{{index $.Translations "settings.status_page.copied"}}">{{index $.Translations "settings.status_page.copy_token"}}</button>
      </div>
    </div>
    {{end}}

    <form method="POST" action="{{$.AppBase}}settings/status-page/tokens/create" class="inline-grid">
      <label>
        <span>{{index $.Translations "settings.status_page.token_name"}}</span>
        <input type="text" name="name" maxlength="80" required>
      </label>
      <label>
        <span>{{index $.Translations "settings.status_page.token_scope"}}</span>
        <select name="scope">
          <option value="metrics">metrics</option>
          <option value="monitors:read">monitors:read</option>
          <option value="monitors:write">monitors:write</option>
        </select>
      </label>
      <label>
        <span>{{index $.Translations "settings.status_page.token_ttl_days"}}</span>
        <input type="number" name="ttl_days" min="0" max="3650" step="1" placeholder="0" value="">
      </label>
      <div class="form-actions">
        <button type="submit" class="button">{{index $.Translations "settings.status_page.token_create"}}</button>
      </div>
    </form>
    <p class="muted compact">{{index $.Translations "settings.status_page.token_ttl_hint"}}</p>

    {{if $sp.Tokens}}
    <div class="table-wrap">
      <table class="admin-table">
        <caption class="sr-only">{{index $.Translations "settings.status_page.tokens_title"}}</caption>
        <thead>
          <tr>
            <th scope="col">{{index $.Translations "settings.status_page.token_name"}}</th>
            <th scope="col">{{index $.Translations "settings.status_page.token_created_at"}}</th>
            <th scope="col">{{index $.Translations "settings.status_page.token_expires_at"}}</th>
            <th scope="col">{{index $.Translations "settings.status_page.token_last_used"}}</th>
            <th scope="col"><span class="sr-only">{{index $.Translations "common.delete"}}</span></th>
          </tr>
        </thead>
        <tbody>
          {{range $sp.Tokens}}
          <tr>
            <td>{{.Name}} <span class="muted">· {{.Scope}}</span></td>
            <td>{{.CreatedAt}}{{if .CreatedBy}} <span class="muted">· {{.CreatedBy}}</span>{{end}}</td>
            <td>{{if .ExpiresAt}}{{.ExpiresAt}}{{else}}<span class="muted">{{index $.Translations "settings.status_page.token_never_expires"}}</span>{{end}}</td>
            <td>{{if .LastUsed}}{{.LastUsed}}{{else}}<span class="muted">{{index $.Translations "settings.status_page.token_never"}}</span>{{end}}</td>
            <td class="table-actions">
              <form method="POST" action="{{$.AppBase}}settings/status-page/tokens/{{.ID}}/rotate" class="inline-form" data-confirm="{{index $.Translations "settings.status_page.token_rotate_confirm"}}">
                <button type="submit" class="button button-secondary button-small">{{index $.Translations "settings.status_page.token_rotate"}}</button>
              </form>
              <form method="POST" action="{{$.AppBase}}settings/status-page/tokens/{{.ID}}/revoke" class="inline-form" data-confirm="{{index $.Translations "settings.status_page.token_revoke_confirm"}}">
                <button type="submit" class="button button-secondary button-small">{{index $.Translations "settings.status_page.token_revoke"}}</button>
              </form>
            </td>
          </tr>
          {{end}}
        </tbody>
      </table>
    </div>
    {{else}}
    <p class="muted">{{index $.Translations "settings.status_page.token_none"}}</p>
    {{end}}

    <h3>{{index $.Translations "settings.status_page.scrape_title"}}</h3>
    <p class="muted compact">{{index $.Translations "settings.status_page.scrape_hint"}} <code>{{$sp.MetricsURL}}</code></p>
  </section>
</div>
{{end}}
