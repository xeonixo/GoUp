{{define "content"}}
{{$sp := .StatusPage}}
{{if $sp.BrandCSSURL}}<link rel="stylesheet" href="{{$sp.BrandCSSURL}}">{{end}}
<div class="status-page">
  <header class="status-page-header">
    {{if $sp.LogoURL}}
    <img class="status-page-logo" src="{{$sp.LogoURL}}" alt="{{$sp.Title}}">
    {{end}}
    <h1>{{$sp.Title}}</h1>
    {{if $sp.Description}}<p class="muted">{{$sp.Description}}</p>{{end}}
  </header>

  <div class="status-banner {{$sp.OverallClass}}" role="status">
    <span class="status-banner-icon" aria-hidden="true"></span>
    <strong>{{$sp.OverallLabel}}</strong>
  </div>

  {{range $sp.MaintenanceNotices}}
  <div class="notice warning">
    <strong>{{index $.Translations "status_page.maintenance"}}:</strong> {{.Title}} <span class="muted">{{.StartsAt}} – {{.EndsAt}}</span>
  </div>
  {{end}}

  {{range $sp.Groups}}
  <section class="status-group" {{if .Name}}aria-label="{{.Name}}"{{end}}>
    {{if .Name}}<h2 class="status-group-title">{{.Name}}</h2>{{end}}
    {{range .Monitors}}
    <article class="card status-item">
      <div class="status-item-head">
        <h3 class="status-item-name">{{.Name}}</h3>
        <span class="status-pill {{.StatusClass}}">{{.StatusLabel}}</span>
      </div>
      <div class="trend-bars status-bars" role="img" aria-label="{{index $.Translations "status_page.uptime_90d"}}: {{.UptimeLabel}}">
        {{range .Bars}}<span class="trend-bar {{.Class}}" title="{{.Label}}"></span>{{end}}
      </div>
      <div class="status-item-foot muted">
        <span>{{index $.Translations "status_page.days_ago"}}</span>
        <span>{{index $.Translations "status_page.uptime_90d"}}: <strong>{{.UptimeLabel}}</strong></span>
        <span>{{index $.Translations "status_page.today"}}</span>
      </div>
    </article>
    {{end}}
  </section>
  {{end}}

  {{if $sp.Incidents}}
  <section class="status-incidents" aria-label="{{index $.Translations "status_page.incidents"}}">
    <h2 class="status-group-title">{{index $.Translations "status_page.incidents"}}</h2>
    <ul class="status-incident-list">
      {{range $sp.Incidents}}
      <li class="status-incident {{if .Open}}is-open{{end}}">
        <strong>{{.Name}}</strong>
        <span class="muted">{{.StartedAt}} – {{.ResolvedAt}}</span>
      </li>
      {{end}}
    </ul>
  </section>
  {{end}}

  <footer class="status-page-footer muted">
    <div>{{index $.Translations "status_page.updated"}}: {{$sp.UpdatedAt}}</div>
    {{if not $sp.HideGoUpFooter}}
    <div class="status-page-powered">{{index $.Translations "status_page.powered_by"}} <span class="status-page-brand">GoUp</span></div>
    {{end}}
  </footer>
</div>
{{end}}
