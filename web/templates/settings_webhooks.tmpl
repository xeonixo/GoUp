{{define "content"}}
<div class="admin-section settings-section">
  <nav class="admin-nav settings-nav" aria-label="{{index $.Translations "layout.settings_title"}}">
    <a href="{{$.AppBase}}" class="admin-nav-link">{{index $.Translations "settings.nav.dashboard"}}</a>
    <a href="{{$.AppBase}}settings/profile" class="admin-nav-link">{{index $.Translations "settings.nav.profile"}}</a>
    <a href="{{$.AppBase}}settings/users" class="admin-nav-link">{{index $.Translations "settings.nav.users"}}</a>
    <a href="{{$.AppBase}}settings/webhooks" class="admin-nav-link is-active">{{index $.Translations "settings.nav.webhooks"}}</a>
    <a href="{{$.AppBase}}settings/providers" class="admin-nav-link">{{index $.Translations "settings.nav.oidc_providers"}}</a>
    <a href="{{$.AppBase}}settings/remote-nodes" class="admin-nav-link">{{index $.Translations "settings.nav.remote_nodes"}}</a>
    <a href="{{$.AppBase}}settings/status-page" class="admin-nav-link">{{index $.Translations "settings.nav.status_page"}}</a>
    <a href="{{$.AppBase}}settings/maintenance" class="admin-nav-link">{{index $.Translations "settings.nav.maintenance"}}</a>
  </nav>

  {{if .Notice}}<div class="notice success">{{.Notice}}</div>{{end}}
  {{if .Error}}<div class="notice error">{{.Error}}</div>{{end}}

  {{if .NewWebhookSecret}}
  <div class="notice warning stack">
    <strong>{{index $.Translations "settings.webhooks.secret_once"}}</strong>
    <div class="status-url-row">
      <input type="text" id="webhook-new-secret" readonly value="{{.NewWebhookSecret}}" autocomplete="off">
      <button type="button" class="button button-secondary" data-action="copy" data-copy-target="webhook-new-secret" data-copied-label="{{index $.Translations "settings.webhooks.secret_copied"}}">{{index $.Translations "settings.webhooks.copy_secret"}}</button>
    </div>
  </div>
  {{end}}

  <div class="admin-header settings-header">
    <div>
      <h1>{{index $.Translations "settings.webhooks.title"}}</h1>
      <p class="muted compact">{{index $.Translations "settings.webhooks.subtitle"}}</p>
    </div>
  </div>

  <form method="POST" action="{{$.AppBase}}settings/webhooks/save" class="admin-form card stack settings-panel">
    <h2>{{index $.Translations "settings.webhooks.new_title"}}</h2>
    <div class="inline-grid">
      <label>
        <span>{{index $.Translations "settings.webhooks.name"}}</span>
        <input type="text" name="name" maxlength="120" required>
      </label>
      <label>
        <span>{{index $.Translations "settings.webhooks.url"}}</span>
        <input type="url" name="url" placeholder="https://hooks.example.com/goup" required>
      </label>
    </div>
    <div class="inline-grid">
      <label>
        <span>{{index $.Translations "settings.webhooks.timeout"}}</span>
        <input type="number" name="timeout_seconds" min="1" max="30" value="10" required>
      </label>
      <label>
        <span>{{index $.Translations "settings.webhooks.secret"}}</span>
        <input type="password" name="secret" placeholder="{{index $.Translations "settings.webhooks.secret_paste_hint"}}" autocomplete="new-password">
      </label>
    </div>
    <p class="muted compact">{{index $.Translations "settings.webhooks.secret_hint"}}</p>
    <label class="toggle-row">
      <input type="checkbox" name="enabled" checked>
      <span>{{index $.Translations "settings.webhooks.enabled"}}</span>
    </label>
    <div class="inline-grid">
      <label>
        <span>{{index $.Translations "settings.webhooks.route_groups"}}</span>
        <input type="text" name="route_groups" placeholder="prod, edge">
      </label>
      <label>
        <span>{{index $.Translations "settings.webhooks.route_monitor_ids"}}</span>
        <input type="text" name="route_monitor_ids" placeholder="1, 2, 3">
      </label>
    </div>
    <fieldset class="stack compact-form">
      <legend>{{index $.Translations "settings.webhooks.route_severities"}}</legend>
      <label class="toggle-row"><input type="checkbox" name="route_severities" value="down"><span>{{index $.Translations "settings.webhooks.route_severity_down"}}</span></label>
      <label class="toggle-row"><input type="checkbox" name="route_severities" value="degraded"><span>{{index $.Translations "settings.webhooks.route_severity_degraded"}}</span></label>
      <label class="toggle-row"><input type="checkbox" name="route_severities" value="recovery"><span>{{index $.Translations "settings.webhooks.route_severity_recovery"}}</span></label>
      <label class="toggle-row"><input type="checkbox" name="route_severities" value="reminder"><span>{{index $.Translations "settings.webhooks.route_severity_reminder"}}</span></label>
    </fieldset>
    <label class="toggle-row">
      <input type="checkbox" name="quiet_hours_enabled">
      <span>{{index $.Translations "settings.webhooks.route_quiet_hours_enabled"}}</span>
    </label>
    <div class="inline-grid">
      <label>
        <span>{{index $.Translations "settings.webhooks.route_quiet_hours_tz"}}</span>
        <input type="text" name="quiet_hours_tz" placeholder="Europe/Berlin">
      </label>
      <label>
        <span>{{index $.Translations "settings.webhooks.route_quiet_hours_start"}}</span>
        <input type="text" name="quiet_hours_start" placeholder="22:00" pattern="[0-2][0-9]:[0-5][0-9]">
      </label>
      <label>
        <span>{{index $.Translations "settings.webhooks.route_quiet_hours_end"}}</span>
        <input type="text" name="quiet_hours_end" placeholder="07:00" pattern="[0-2][0-9]:[0-5][0-9]">
      </label>
    </div>
    <div class="form-actions">
      <button type="submit" class="button button-secondary" name="generate_secret" value="1">{{index $.Translations "settings.webhooks.generate_secret"}}</button>
      <button type="submit" class="button">{{index $.Translations "settings.webhooks.create_button"}}</button>
    </div>
  </form>

  <div class="card table-card settings-table-card">
    <table class="admin-table">
      <thead>
        <tr>
          <th scope="col">{{index $.Translations "settings.webhooks.name"}}</th>
          <th scope="col">{{index $.Translations "settings.webhooks.url"}}</th>
          <th scope="col">{{index $.Translations "settings.webhooks.timeout"}}</th>
          <th scope="col">{{index $.Translations "settings.webhooks.secret_status"}}</th>
          <th scope="col">{{index $.Translations "settings.webhooks.status"}}</th>
          <th scope="col">{{index $.Translations "settings.webhooks.actions"}}</th>
        </tr>
      </thead>
      <tbody>
        {{if .AdminWebhookEndpoints}}
        {{range .AdminWebhookEndpoints}}
        <tr>
          <td>{{.Name}}</td>
          <td class="break-all">{{.URL}}</td>
          <td>{{.TimeoutSeconds}}s</td>
          <td>
            {{if .SecretConfigured}}
            <span class="status-badge status-badge-success">{{index $.Translations "settings.webhooks.secret_present"}}</span>
            {{else}}
            <span class="status-badge status-badge-muted">{{index $.Translations "settings.webhooks.secret_missing"}}</span>
            {{end}}
          </td>
          <td>
            {{if .Enabled}}
            <span class="status-badge status-badge-success">{{index $.Translations "common.active"}}</span>
            {{else}}
            <span class="status-badge status-badge-muted">{{index $.Translations "common.inactive"}}</span>
            {{end}}
          </td>
          <td>
            <form method="POST" action="{{$.AppBase}}settings/webhooks/save" class="stack compact-form">
              <input type="hidden" name="id" value="{{.ID}}">
              <div class="inline-grid">
                <input type="text" name="name" value="{{.Name}}" maxlength="120" required>
                <input type="url" name="url" value="{{.URL}}" required>
              </div>
              <div class="inline-grid">
                <input type="number" name="timeout_seconds" min="1" max="30" value="{{.TimeoutSeconds}}" required>
                <input type="password" name="secret" placeholder="{{index $.Translations "settings.webhooks.secret_rotate_placeholder"}}" autocomplete="new-password">
              </div>
              <p class="muted compact">{{index $.Translations "settings.webhooks.secret_rotate_hint"}}</p>
              <div class="inline-grid">
                <input type="text" name="route_groups" value="{{.Route.GroupsCSV}}" placeholder="prod, edge">
                <input type="text" name="route_monitor_ids" value="{{.Route.MonitorIDsCSV}}" placeholder="1, 2, 3">
              </div>
              <fieldset class="stack compact-form">
                <legend>{{index $.Translations "settings.webhooks.route_severities"}}</legend>
                <label class="toggle-row"><input type="checkbox" name="route_severities" value="down" {{if .Route.HasSeverity "down"}}checked{{end}}><span>{{index $.Translations "settings.webhooks.route_severity_down"}}</span></label>
                <label class="toggle-row"><input type="checkbox" name="route_severities" value="degraded" {{if .Route.HasSeverity "degraded"}}checked{{end}}><span>{{index $.Translations "settings.webhooks.route_severity_degraded"}}</span></label>
                <label class="toggle-row"><input type="checkbox" name="route_severities" value="recovery" {{if .Route.HasSeverity "recovery"}}checked{{end}}><span>{{index $.Translations "settings.webhooks.route_severity_recovery"}}</span></label>
                <label class="toggle-row"><input type="checkbox" name="route_severities" value="reminder" {{if .Route.HasSeverity "reminder"}}checked{{end}}><span>{{index $.Translations "settings.webhooks.route_severity_reminder"}}</span></label>
              </fieldset>
              <label class="toggle-row">
                <input type="checkbox" name="quiet_hours_enabled" {{if .Route.QuietHours}}checked{{end}}>
                <span>{{index $.Translations "settings.webhooks.route_quiet_hours_enabled"}}</span>
              </label>
              <div class="inline-grid">
                <input type="text" name="quiet_hours_tz" value="{{if .Route.QuietHours}}{{.Route.QuietHours.TZ}}{{end}}" placeholder="Europe/Berlin">
                <input type="text" name="quiet_hours_start" value="{{if .Route.QuietHours}}{{.Route.QuietHours.Start}}{{end}}" placeholder="22:00" pattern="[0-2][0-9]:[0-5][0-9]">
                <input type="text" name="quiet_hours_end" value="{{if .Route.QuietHours}}{{.Route.QuietHours.End}}{{end}}" placeholder="07:00" pattern="[0-2][0-9]:[0-5][0-9]">
              </div>
              <div class="admin-actions-inline">
                <label class="toggle-row">
                  <input type="checkbox" name="enabled" {{if .Enabled}}checked{{end}}>
                  <span>{{index $.Translations "settings.webhooks.enabled"}}</span>
                </label>
                <button type="submit" class="button button-secondary button-small" name="generate_secret" value="1">{{index $.Translations "settings.webhooks.generate_secret"}}</button>
                <button type="submit" class="button button-secondary button-small">{{index $.Translations "common.save"}}</button>
              </div>
            </form>
            <form method="POST" action="{{$.AppBase}}settings/webhooks/{{.ID}}/test" class="inline-form">
              <button type="submit" class="button button-secondary button-small" {{if or (not .Enabled) (not .SecretConfigured)}}disabled{{end}}>{{index $.Translations "settings.webhooks.test_button"}}</button>
            </form>
            <form method="POST" action="{{$.AppBase}}settings/webhooks/{{.ID}}/delete" class="inline-form" data-confirm="{{index $.Translations "settings.webhooks.delete_confirm"}}">
              <button type="submit" class="button button-danger button-small">{{index $.Translations "common.delete"}}</button>
            </form>
          </td>
        </tr>
        {{end}}
        {{else}}
        <tr>
          <td colspan="6" class="muted">{{index $.Translations "settings.webhooks.empty"}}</td>
        </tr>
        {{end}}
      </tbody>
    </table>
  </div>
</div>
{{end}}
