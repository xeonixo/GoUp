{{define "topbar_actions"}}
<div class="topbar-dashboard-actions">
  <div class="live-connection-indicator is-connecting" id="live-ws-indicator" role="status" aria-live="polite" aria-label="{{index $.Translations "dashboard.live.connecting"}}" title="{{index $.Translations "dashboard.live.connecting"}}">
    <span class="live-connection-dot" aria-hidden="true"></span>
    <span class="live-connection-text">{{index $.Translations "layout.live_indicator"}}</span>
  </div>
  <div class="trend-range-toggle topbar-trend-range" role="tablist" aria-label="{{index $.Translations "dashboard.topbar.trend_range"}}">
  {{range .TrendRanges}}
  <a href="{{$.AppBase}}?trend={{.Value}}" class="button button-small {{if not .Selected}}button-secondary{{end}}" role="tab" aria-selected="{{if .Selected}}true{{else}}false{{end}}" {{if .Selected}}aria-current="page"{{end}}>{{.Label}}</a>
  {{end}}
  </div>
  {{if .IsAdmin}}
  <a href="{{$.AppBase}}monitors/export" class="button button-secondary button-small">{{index $.Translations "dashboard.topbar.export_monitors"}}</a>
  <a href="{{$.AppBase}}monitors/import" class="button button-secondary button-small">{{index $.Translations "dashboard.topbar.import_monitors"}}</a>
  <button class="button" type="button" id="open-create-monitor">{{index $.Translations "dashboard.topbar.create_monitor"}}</button>
  {{end}}
</div>
{{end}}

{{define "content"}}
{{if .Notice}}
<section class="notice success">{{.Notice}}</section>
{{end}}
{{if .Error}}
<section class="notice error">{{.Error}}</section>
{{end}}

<div id="dashboard-page" data-app-base="{{$.AppBase}}" data-trend-value="{{.TrendValue}}" data-state-owner="{{if .User}}{{if .User.Email}}{{.User.Email}}{{else}}{{.User.Name}}{{end}}{{end}}" data-is-admin="{{if .IsAdmin}}1{{else}}0{{end}}">

{{template "dashboard_stats" .}}

{{template "dashboard_monitor_modal" .}}

{{template "dashboard_group_modal" .}}

{{template "dashboard_trend_modal" .}}

{{template "dashboard_toolbar" .}}



{{template "dashboard_board" .}}

{{template "dashboard_bulk_bar" .}}

{{template "dashboard_state_events" .}}

{{template "dashboard_notification_events" .}}
</div>
{{end}}

{{define "page_scripts"}}
{{template "dashboard_i18n" .}}
<script src="/static/dashboard.js?v={{$.AssetVersion}}" defer></script>
<script src="/static/dashboard-board.js?v={{$.AssetVersion}}" defer></script>
{{end}}
