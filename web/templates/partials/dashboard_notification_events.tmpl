{{define "dashboard_notification_events"}}<details id="dashboard-live-notification-events" class="card stack notification-events-card dashboard-activity-panel">
  <summary class="activity-summary">
    <div>
      <h2>{{index $.Translations "dashboard.notification_events.title"}}</h2>
      {{if .Events}}<span class="muted">{{index $.Translations "dashboard.events.latest_prefix"}} {{len .Events}} {{index $.Translations "common.entries"}}</span>{{end}}
    </div>
    <span class="activity-summary-caret">⌄</span>
  </summary>
  {{if .Events}}
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th scope="col">{{index $.Translations "dashboard.notification_events.time"}}</th>
          <th scope="col">{{index $.Translations "dashboard.notification_events.monitor"}}</th>
          <th scope="col">{{index $.Translations "dashboard.notification_events.event"}}</th>
          <th scope="col">{{index $.Translations "dashboard.notification_events.endpoint"}}</th>
          <th scope="col">{{index $.Translations "dashboard.notification_events.result"}}</th>
          <th scope="col">{{index $.Translations "dashboard.notification_events.error"}}</th>
          <th scope="col">{{index $.Translations "dashboard.notification_events.delivered"}}</th>
        </tr>
      </thead>
      <tbody id="notification-events-body">
        {{range .Events}}
        <tr>
          <td><time class="client-time" datetime="{{.WhenRaw}}" data-format="datetime">{{.When}}</time></td>
          <td>{{.Monitor}}</td>
          <td>{{.EventType}}</td>
          <td title="{{.Endpoint}}"><span class="notification-endpoint-cell">{{.Endpoint}}</span></td>
          <td title="{{.Result}}"><span class="notification-result-cell">{{.Result}}</span></td>
          <td class="break-all" title="{{.Error}}"><span class="notification-error-cell">{{.Error}}</span></td>
          <td>{{if .DeliveredAtRaw}}<time class="client-time" datetime="{{.DeliveredAtRaw}}" data-format="datetime">{{.DeliveredAt}}</time>{{else}}—{{end}}</td>
        </tr>
        {{end}}
      </tbody>
    </table>
  </div>
  <div class="table-pagination" id="notification-events-pagination" hidden></div>
  <div class="section-footer-link">
    <a href="{{$.AppBase}}notification-events">{{index $.Translations "dashboard.notification_events.view_all"}}</a>
  </div>
  {{else}}
  <p class="muted">{{index $.Translations "dashboard.notification_events.empty"}}</p>
  {{end}}
</details>{{end}}
