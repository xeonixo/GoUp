GOUP_ADDR=:8080
GOUP_BASE_URL=http://localhost:8080
GOUP_DATA_DIR=/data
GOUP_LOG_LEVEL=info
# Log format: text (default) or json (structured slog JSONHandler).
#GOUP_LOG_FORMAT=text
# Set to customize the number of workers for monitoring tasks. Default is 4.
GOUP_MONITOR_WORKERS=4

# Required security keys.
# Generate each key independently with: openssl rand -hex 32
# Keep these values stable across restarts and backups. Do not reuse the same
# value for multiple keys.
# Each key must be >= 32 characters and different from the other two; the
# "replace-with..." placeholders below are rejected at startup.
GOUP_SESSION_KEY=replace-with-output-of-openssl-rand-hex-32
GOUP_SSO_SECRET_KEY=replace-with-another-output-of-openssl-rand-hex-32
# Optional previous SSO secret key used only while rotating encryption keys.
# Set this to the old GOUP_SSO_SECRET_KEY, point GOUP_SSO_SECRET_KEY at the new
# value, run `goup rekey-secrets`, then remove this variable.
#GOUP_SSO_SECRET_KEY_PREVIOUS=
GOUP_CONTROL_PLANE_ADMIN_KEY=replace-with-a-third-output-of-openssl-rand-hex-32

# Reverse proxy: comma separated CIDRs/IPs of your proxy as seen by GoUp.
# Forwarded headers (client IP, X-Forwarded-Proto) are ONLY trusted from these.
# Without it all clients appear with the proxy's IP address.
#GOUP_TRUSTED_PROXIES=172.19.27.1/32

# Initial /admin/setup requires a token. If unset, a random one is logged at startup.
#GOUP_SETUP_TOKEN=

# HTTP(S)/TCP/mail monitors may reach private networks (cloud metadata IPs are
# always blocked). Set to false to restrict monitors to public targets.
#GOUP_MONITOR_ALLOW_PRIVATE=true

# Matrix homeserver and OIDC issuer URLs must be https and public by default
# (SSRF protection). Set to true if your Keycloak/Matrix runs on a private IP.
#GOUP_ALLOW_PRIVATE_INTEGRATIONS=false

# Control-plane audit_events retention in days (default 90). Older rows are
# pruned during background maintenance.
#GOUP_AUDIT_RETENTION_DAYS=90

# Optional HTTPS listen (required for in-process remote-node mTLS).
#GOUP_TLS_CERT_FILE=/certs/server.crt
#GOUP_TLS_KEY_FILE=/certs/server.key

# Optional mTLS for remote nodes (/node/bootstrap|poll|report). Additive to
# bootstrap-key / bearer-token auth. GoUp must terminate TLS (see above).
#GOUP_REMOTE_NODE_MTLS_CA_FILE=/certs/remote-node-client-ca.crt
#GOUP_REMOTE_NODE_MTLS_REQUIRE=false

# Remote-node agent only: optional client certificate for mTLS to the CP.
#REMOTE_NODE_TLS_CERT_FILE=/certs/node.crt
#REMOTE_NODE_TLS_KEY_FILE=/certs/node.key
#REMOTE_NODE_TLS_CA_FILE=/certs/server-ca.crt
